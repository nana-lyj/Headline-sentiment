n pd.Series({\n","            \"sentiment_label\":      dominant,\n","            \"sentiment_confidence\": scores[dominant],\n","            **{f\"score_{s}\": scores.get(s, 0.0) for s in SENTIMENTS}\n","        })\n","\n","    except Exception as exc:\n","        print(f\"  Error → {str(text)[:60]}  |  {exc}\")\n","        return nan_row"],"metadata":{"id":"Pl7re8JySMwl","executionInfo":{"status":"ok","timestamp":1792836535256,"user_tz":-480,"elapsed":84,"user":{"displayName":"na na","userId":"04015591375855126319"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","execution_count":5,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":49,"referenced_widgets":["93ce15ab676a4a1ba645ef56877d9120","cca3b767da8249709209aefa9bb20f50","0bd1c2cabfe04206b579d5d4d82b9f9f","9b7d9a98038547c0b78765034e0a8970","960c93b29e5f445782e1c353e19f9ba0","cb7d88afd3f94e30a9f350a348659357","a1e052385d144ca08fe2fc6ae893085d","267f1803402849a5ab79edebd7ef8bca","5b83dc33e1394abea7379299ab536ad6","51328d7ca6db4409b9bf72fe05e2cba3","9b1ee568ea6842dfbcf64378c32c07a0"]},"id":"LhWEdogSQPir","executionInfo":{"status":"ok","timestamp":1792836614118,"user_tz":-480,"elapsed":78861,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"ef5c663a-097f-4589-9b6c-dd66e59f0f3f"},"outputs":[{"output_type":"display_data","data":{"text/plain":["Chinese sentiment:   0%|          | 0/274 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"93ce15ab676a4a1ba645ef56877d9120"}},"metadata":{}}],"source":["# ── 4. Run on Chinese Titles ──────────────────────────────────\n","tqdm.pandas(desc=\"Chinese sentiment\")\n","cn_sent = df[\"Source Titles\"].progress_apply(analyze_sentiment)\n","cn_sent.columns = [\"chinese_\" + c for c in cn_sent.columns]\n","df = pd.concat([df, cn_sent], axis=1)"]},{"cell_type":"code","source":["# ── 5. Run on English Titles ──────────────────────────────────\n","tqdm.pandas(desc=\"English sentiment\")\n","en_sent = df[\"English Titles\"].progress_apply(analyze_sentiment)\n","en_sent.columns = [\"english_\" + c for c in en_sent.columns]\n","df = pd.concat([df, en_sent], axis=1)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":49,"referenced_widgets":["4f014f5aac4a42ceaf18519f6f6b2021","59f95fbadd304dc6832ce9b687d430e7","add0ef3279014b03a6e4369aeb88c32f","9cf02055800e40858d16a863c9517c88","671a83588845469590e735eeeff7f402","4b17d25ca745458399ed97de9303827f","9fa9af0f753f452f8b1a60614046d343","2c2e0629fa504fca9e4b3a1766948634","079cf29d8f8a420aa7acab65e1804761","52107dc1e02e4ebfbb09e5041c3d4a26","7dd2015abe174fd795b4fd9d8f8cdd7a"]},"id":"T_ucv6mEQb7U","executionInfo":{"status":"ok","timestamp":1792836657826,"user_tz":-480,"elapsed":43696,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"764bda04-b583-41ee-b104-0928a6905380"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["English sentiment:   0%|          | 0/274 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4f014f5aac4a42ceaf18519f6f6b2021"}},"metadata":{}}]},{"cell_type":"code","source":["# ── 6. Agreement Analysis ─────────────────────────────────────\n","df[\"same_sentiment\"] = (\n","    df[\"chinese_sentiment_label\"] == df[\"english_sentiment_label\"]\n",")\n","n_valid   = df[\"chinese_sentiment_label\"].notna().sum()\n","agreement = df[\"same_sentiment\"].mean()\n","print(f\"\\nSentiment agreement rate: {agreement:.2%}  (n = {n_valid})\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LJQ6SgRHQevq","executionInfo":{"status":"ok","timestamp":1792836657949,"user_tz":-480,"elapsed":116,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"09f6f10c-b2be-4d37-e349-ff1a65a94797"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Sentiment agreement rate: 63.14%  (n = 273)\n"]}]},{"cell_type":"code","source":["# ── 7. Distribution + Chi-Square Test ────────────────────────\n","cn_dist = (df[\"chinese_sentiment_label\"]\n","           .value_counts()\n","           .reindex(SENTIMENTS, fill_value=0))\n","en_dist = (df[\"english_sentiment_label\"]\n","           .value_counts()\n","           .reindex(SENTIMENTS, fill_value=0))\n","\n","cn_pct = cn_dist / cn_dist.sum() * 100\n","en_pct = en_dist / en_dist.sum() * 100\n","\n","dist_df = pd.DataFrame({\n","    \"Chinese (n)\": cn_dist,\n","    \"Chinese (%)\": cn_pct.round(1),\n","    \"English (n)\": en_dist,\n","    \"English (%)\": en_pct.round(1),\n","})\n","print(\"\\n── Sentiment Distribution ────────────────────────────\")\n","print(dist_df)\n","\n","contingency          = np.array([cn_dist.values, en_dist.values])\n","chi2, p_val, dof, _  = chi2_contingency(contingency)\n","print(f\"\\nChi-square: χ²({dof}) = {chi2:.3f},  p = {p_val:.4f}\")\n","\n","# ── Per-category agreement rate ───────────────────────────────\n","cat_agree = (\n","    df.groupby(\"chinese_sentiment_label\")[\"same_sentiment\"]\n","    .mean() * 100\n",").reindex(SENTIMENTS).round(1)\n","\n","table1 = pd.DataFrame({\n","    \"CN n\":          cn_dist.values,\n","    \"CN %\":          cn_pct.round(1).values,\n","    \"EN n\":          en_dist.values,\n","    \"EN %\":          en_pct.round(1).values,\n","    \"Agreement %\":   cat_agree.values,\n","}, index=[s.capitalize() for s in SENTIMENTS])\n","\n","table1.index.name = \"Sentiment Label\"\n","print(table1)\n","print(f\"\\nOverall agreement: {agreement:.1%}\")\n","print(f\"Chi-square: χ²({dof}) = {chi2:.3f},  p = {p_val:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wNUVP_fwQj9R","executionInfo":{"status":"ok","timestamp":1792836657965,"user_tz":-480,"elapsed":17,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"bf3621e7-75e4-4e09-a58f-967f72f9a99f"},"execution_count":8,"outputs":[{"output_type":"stream","name":"