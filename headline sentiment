ution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","── Chinese Title Emotion Distribution ──\n","cn_emo_top_label\n","joy        112\n","sadness     87\n","fear        44\n","anger       30\n","Name: count, dtype: int64\n","\n","── English Title Emotion Distribution ──\n","en_emo_top_label\n","joy        127\n","anger       70\n","sadness     51\n","fear        26\n","Name: count, dtype: int64\n","\n","── Emotion Distribution: Chinese vs. English ──\n","Emotion        CN (n)   CN (%)   EN (n)   EN (%)\n","------------------------------------------------\n","anger              30    10.9%       70    25.5%\n","fear               44    16.1%       26     9.5%\n","joy               112    40.9%      127    46.4%\n","sadness            87    31.8%       51    18.6%\n","\n","Chi-square test: χ²(3) = 30.960, p = 0.0000\n","\n","── Agreement Rate by CN Emotion Label ──\n","Emotion         Total    Agree     Rate\n","----------------------------------------\n","anger              30       15    50.0%\n","fear               44        6    13.6%\n","joy               112       71    63.4%\n","sadness            87       25    28.7%\n","\n","Overall agreement: 117/274 (42.7%)\n"]}]},{"cell_type":"code","source":["# ── 6. Save to Excel ──────────────────────────────────────────\n","output_path = (\n","    \"/content/drive/My Drive/Colab Notebooks/Headlines/\"\n","    \"Headlines_emotion_results.xlsx\"\n",")\n","print(f\"\\nSaving results to: {output_path} ...\")\n","df_result.to_excel(output_path, index=False)\n","print(f\"File saved successfully ✓  →  {output_path}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hOw4PhBwXNJm","executionInfo":{"status":"ok","timestamp":1792836863524,"user_tz":-480,"elapsed":472,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"474a76b1-4684-4dca-9721-e2ae7d8599a7"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Saving results to: /content/drive/My Drive/Colab Notebooks/Headlines/Headlines_emotion_results.xlsx ...\n","File saved successfully ✓  →  /content/drive/My Drive/Colab Notebooks/Headlines/Headlines_emotion_results.xlsx\n"]}]},{"cell_type":"markdown","source":["# Emotion results visualization"],"metadata":{"id":"M_vjUX_gdEsc"}},{"cell_type":"code","source":["import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.lines as mlines\n","import seaborn as sns\n","import numpy as np\n","from scipy.stats import chi2_contingency, pearsonr\n","\n","# ══════════════════════════════════════════════════════════════════\n","# Config\n","# ══════════════════════════════════════════════════════════════════\n","CN_COLOR    = \"#2166ac\"\n","EN_COLOR    = \"#d6604d\"\n","EMOTIONS    = [\"anger\", \"fear\", \"joy\", \"sadness\"]\n","EMO_PALETTE = {\n","    \"anger\":   \"#d6604d\",\n","    \"fear\":    \"#762a83\",\n","    \"joy\":     \"#4dac26\",\n","    \"sadness\": \"#2166ac\",\n","}\n","\n","SAVE_DIR    = \"/content/drive/My Drive/Colab Notebooks/Headlines/\"\n","\n","df_result[\"emo_agree\"] = (df_result[\"cn_emo_top_label\"] == df_result[\"en_emo_top_label\"])\n","n_total  = len(df_result)\n","n_agree  = int(df_result[\"emo_agree\"].sum())\n","emo_pos  = {e: i for i, e in enumerate(EMOTIONS)}\n","\n","plt.rcParams.update({\"font.size\": 10, \"figure.dpi\": 150})\n","\n","def bezier_curve(y0, y1, n=80):\n","    t  = np.linspace(0, 1, n)\n","    bx = 3*(1-t)**2*t*0.4 + 3*(1-t)*t**2*0.6 + t**3\n","    by = y0*(1-t)**2*(1+2*t) + y1*t**2*(3-2*t)\n","    return bx, by"],"metadata":{"id":"_VhHKN4vf9r_","executionInfo":{"status":"ok","timestamp":1792836863530,"user_tz":-480,"elapsed":5,"user":{"displayName":"na na","userId":"04015591375855126319"}}},"execution_count":21,"outputs":[]},{"cell_type":"code","source":["# ══════════════════════════════════════════════════════════════════\n","# Figure 1 ─ Combined (a) Distribution  (b) Agreement\n","# ══════════════════════════════════════════════════════════════════\n","\n","# ── Prepare ───────────────────────────────────────────────────────\n","_cn_counts = df_result[\"cn_emo_top_label\"].value_counts()\n","_en_counts = df_result[\"en_emo_top_label\"].value_counts()\n","_total     = len(df_result)\n","\n","cn_pct     = (_cn_counts / _total * 100).reindex(EMOTIONS, fill_value=0)\n","en_pct     = (_en_counts / _total * 100).reindex(EMOTIONS, fill_value=0)\n","agree_n    = df_result[df_result[\"emo_agree\"]].groupby(\"cn_emo_top_label\").size().reindex(EMOTIONS, fill_value=0)\n","disagree_n = df_result[~df_result[\"emo_agree\"]].groupby(\"cn_emo_top_label\").size().reindex(EMOTIONS, fill_value=0)\n","\n","fig, (ax1, ax4) = plt.subplots(1, 2, figsize=(12, 5))\n","\n","# ── (a) Emotion Label Distribution ────────────────────────────────\n","x, w = np.arange(len(EMOTIONS)), 0.35\n","\n","b1_cn = ax1.bar(x - w/2, cn_pct.values, w, label=\"Chinese\", color=CN_COLOR, zorder=3)\n","b1_en = ax1.bar(x + w/2, en_pct.values, w, label=\"English\",  color=EN_COLOR, zorder=3)\n","\n","for bar, v in zip(b1_cn, cn_pct):\n","    ax1.text(bar.get_x() + w/2, bar.get_height() + 0.5,\n","             f\"{v:.1f}%\", ha=\"center\", va=\"bottom\", fontsize=8.5)\n","for bar, v in zip(b1_en, en_pct):\n","    ax1.text(bar.get_x() + w/2, bar.get_height() + 0.5,\n","             f\"{v:.1f}%\", ha=\"center\", va=\"bottom\", fontsize=8.5)\n","\n","ax1.set_xticks(x)\n","ax1.set_xticklabels([e.capitalize() for e in EMOTIONS])\n","ax1.set_ylabel(\"Percentage (%)\")\n","ax1.set_ylim(0, max(cn_pct.max(), en_pct.max()) + 14)\n","ax1.set_title(\"(A) Emotion Label Distribution — Chinese vs. English Headlines\",\n","              fontsize=10, fontweight=\"bold\", loc=\"center\")\n","ax1.legend(fontsize=9)\n","ax1.yaxis.grid(True, linestyle=\"--\", alpha=0.6, zorder=0)\n","ax1.set_axisbelow(True)\n","ax1.spines[[\"top\", \"right\"]].set_visible(False)\n","ax1.text(0.98, 0.97,\n","         f\"χ²({dof}) = {chi2:.2f},  p = {p:.4f}\\n\"\n","         f\"Label agreement = {overall_agree}/{_total} ({overall_agree/_total:.1%})\",\n","         transform=ax1.transAxes, ha=\"right\", va=\"top\", fontsize=8.5,\n","         bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"#f5f5f5\", edgecolor=\"#ccc\"))\n","\n","# ── (b) Agreement by CN Emotion Label ─────────────────────────────\n","x4 = np.arange(len(EMOTIONS))\n","\n","ax4.bar(x4, agree_n,    label=\"Agree\",    color=CN_COLOR, width=0.7, zorder=3)\n","ax4.bar(x4, disagree_n, bottom=agree_n,   label=\"Disagree\", color=EN_COLOR, width=0.7, alpha=0.8, zorder=3)\n","\n","for i, (a, d) in enumerate(zip(agree_n, disagree_n)):\n","    total_bar = a + d\n","    if total_bar == 0:\n","        continue\n","    ax4.text(i, total_bar + 0.8, f\"{a/total_bar:.1%}\",\n","             ha=\"center\", va=\"bottom\", fontsize=9, fontweight=\"bold\")\n","\n","ax4.set_xticks(x4)\n","ax4.set_xticklabels([e.capitalize() for e in EMOTIONS])\n","ax4.set_ylabel(\"Number of Headlines\")\n","ax4.set_title(\"(B) Emotion Agreement by CN Emotion Label\",\n","              fontsize=10, fontweight=\"bold\")\n","ax4.legend(fontsize=9)\n","ax4.yaxis.grid(True, linestyle=\"--\", alpha=0.6, zorder=0)\n","ax4.set_axisbelow(True)\n","ax4.spines[[\"top\", \"right\"]].set_visible(False)\n","\n","plt.tight_layout()\n","plt.savefig(SAVE_DIR + \"emotion_fig1.png\", dpi=2000, bbox_inches=\"tight\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":343},"id":"4Tq2U7LWb-pt","executionInfo":{"status":"ok","timestamp":1792837688311,"user_tz":-480,"elapsed":55208,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"72759e40-1178-4810-cfcf-d1336f4841e7"},"execution_count":27,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 3600x1500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ══════════════════════════════════════════════════════════════════\n","# Quick Check: Agreement Rate per Emotion\n","# ══════════════════════════════════════════════════════════════════\n","print(f\"{'Emotion':<12} | {'Total':>6} | {'Agree':>6} | {'Rate':>6}\")\n","print(\"-\" * 40)\n","for e in EMOTIONS:\n","    total = (df_result[\"cn_emo_top_label\"] == e).sum()\n","    agree = ((df_result[\"cn_emo_top_label\"] == e) &\n","             (df_result[\"en_emo_top_label\"] == e)).sum()\n","    if total > 0:\n","        print(f\"{e:<12} | {total:>6} | {agree:>6} | {agree/total:>6.1%}\")\n","\n","# ══════════════════════════════════════════════════════════════════\n","# Figure 2 ─ Slope / Flow Chart  (Article-level CN → EN)\n","# ══════════════════════════════════════════════════════════════════\n","fig2, ax2 = plt.subplots(figsize=(8, 6))\n","rng = np.random.default_rng(42)\n","\n","# ── Pre-compute CN total count per emotion\n","cn_total = df_result[\"cn_emo_top_label\"].value_counts()\n","\n","# ── Thin lines: one per article (with jitter)\n","for _, row in df_result.iterrows():\n","    cn_e = row[\"cn_emo_top_label\"]\n","    en_e = row[\"en_emo_top_label\"]\n","    if cn_e not in emo_pos or en_e not in emo_pos:\n","        continue\n","    jcn, jen = rng.uniform(-0.12, 0.12), rng.uniform(-0.12, 0.12)\n","    agree  = (cn_e == en_e)\n","    clr    = EMO_PALETTE[cn_e]\n","    alpha  = 0.22 if agree else 0.10\n","    bx, by = bezier_curve(emo_pos[cn_e] + jcn, emo_pos[en_e] + jen)\n","    ax2.plot(bx, by, color=clr, lw=0.6, alpha=alpha)\n","\n","# ── Thick lines: aggregate flow (width ∝ √proportion)\n","for cn_e in EMOTIONS:\n","    for en_e in EMOTIONS:\n","        cnt = int(((df_result[\"cn_emo_top_label\"] == cn_e) &\n","                   (df_result[\"en_emo_top_label\"] == en_e)).sum())\n","        if cnt == 0:\n","            continue\n","        total      = cn_total.get(cn_e, 1)\n","        proportion = cnt / total\n","        agree      = (cn_e == en_e)\n","        clr        = EMO_PALETTE[cn_e]\n","        lw_agg     = np.sqrt(proportion * 100) * 0.9\n","        alpha      = 0.85 if agree else 0.35\n","        ls         = \"-\" if agree else \"--\"\n","        bx, by     = bezier_curve(emo_pos[cn_e], emo_pos[en_e])\n","        ax2.plot(bx, by, color=clr, lw=lw_agg, alpha=alpha, linestyle=ls)\n","        if agree and proportion >= 0.05:\n","            ax2.text(0.5, emo_pos[cn_e] + 0.1,\n","                     f\"{proportion:.1%}\",\n","                     ha=\"center\", va=\"bottom\", fontsize=8,\n","                     color=clr, fontweight=\"bold\")\n","\n","# ── Axes\n","ax2.set_xlim(-0.08, 1.08)\n","ax2.set_ylim(-0.6, len(EMOTIONS) - 0.4)\n","ax2.set_xticks([0, 1])\n","ax2.set_xticklabels([\"Chinese\", \"English\"], fontweight=\"bold\", fontsize=12)\n","ax2.tick_params(axis=\"x\", pad=-35)\n","ax2.set_yticks([])\n","\n","# ── Emotion labels (left & right)\n","for e, p in emo_pos.items():\n","    ax2.text(-0.05, p, e.capitalize(), ha=\"right\", va=\"center\",\n","             fontsize=10.5, color=EMO_PALETTE[e], fontweight=\"bold\")\n","    ax2.text(1.05, p, e.capitalize(), ha=\"left\", va=\"center\",\n","             fontsize=10.5, color=EMO_PALETTE[e], fontweight=\"bold\")\n","\n","# ── Remove spines\n","for sp in ax2.spines.values():\n","    sp.set_visible(False)\n","ax2.tick_params(bottom=False)\n","\n","# ── Legend (below Chinese/English)\n","legs2 = [\n","    mlines.Line2D([], [], color=\"#888\", lw=2.5, linestyle=\"-\",\n","                  label=\"Agree  (colored by CN emotion)\"),\n","    mlines.Line2D([], [], color=\"#888\", lw=2.0, linestyle=\"--\",\n","                  label=\"Disagree  (colored by CN emotion, faded)\"),\n","    mlines.Line2D([], [], color=\"#333\", lw=0,\n","                  label=\"line width = transition frequency\"),\n","]\n","ax2.legend(handles=legs2, fontsize=8.5, loc=\"lower center\",\n","           bbox_to_anchor=(0.5, -0.015),\n","           ncol=3, framealpha=0.7)\n","\n","# ── Title\n","ax2.set_title(\"Emotion Mapping Flow: CN → EN\",\n","              fontsize=11, fontweight=\"bold\",\n","              loc=\"center\", pad=-6, y=0.97)\n","\n","plt.tight_layout()\n","plt.savefig(SAVE_DIR + \"emotion_fig2_slope.png\", dpi=2000, bbox_inches=\"tight\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":708},"id":"3oNS8PB8nJls","executionInfo":{"status":"ok","timestamp":1792837759724,"user_tz":-480,"elapsed":54445,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"a6dedde5-09da-429f-9b0f-95adbf016177"},"execution_count":28,"outputs":[{"output_type":"stream","name":"stdout","text":["Emotion      |  Total |  Agree |   Rate\n","----------------------------------------\n","anger        |     30 |     15 |  50.0%\n","fear         |     44 |      6 |  13.6%\n","joy          |    112 |     71 |  63.4%\n","sadness      |     87 |     25 |  28.7%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2400x1800 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ══════════════════════════════════════════════════════════════════\n","# Figure 3 ─ Transition Heatmap  (CN → EN, row-normalised)\n","# ══════════════════════════════════════════════════════════════════\n","cross_pct = (pd.crosstab(df_result[\"cn_emo_top_label\"],\n","                         df_result[\"en_emo_top_label\"],\n","                         normalize=\"index\") * 100\n","             ).reindex(index=EMOTIONS, columns=EMOTIONS, fill_value=0)\n","\n","cross_raw = pd.crosstab(df_result[\"cn_emo_top_label\"],\n","                        df_result[\"en_emo_top_label\"]\n","                        ).reindex(index=EMOTIONS, columns=EMOTIONS, fill_value=0)\n","\n","annot_mat = cross_raw.astype(str) + \"\\n(\" + cross_pct.round(1).astype(str) + \"%)\"\n","\n","fig3, ax3 = plt.subplots(figsize=(6, 5))\n","sns.heatmap(cross_pct, annot=annot_mat, fmt=\"\", cmap=\"Blues\",\n","            linewidths=0.5, linecolor=\"#ddd\", ax=ax3,\n","            cbar_kws={\"label\": \"% within CN emotion\", \"shrink\": 0.85})\n","ax3.set_xlabel(\"English Emotion Label\")\n","ax3.set_ylabel(\"Chinese Emotion Label\")\n","ax3.set_title(\"Emotion Transition Heatmap\", fontsize=10, fontweight=\"bold\")\n","ax3.tick_params(axis=\"x\", rotation=30)\n","ax3.tick_params(axis=\"y\", rotation=0)\n","\n","plt.tight_layout()\n","plt.savefig(SAVE_DIR + \"emotion_fig3_heatmap.png\", dpi=2000, bbox_inches=\"tight\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":685},"id":"8IiEYF1aoOyJ","executionInfo":{"status":"ok","timestamp":1792837801205,"user_tz":-480,"elapsed":24182,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"9b32f51c-9973-4dab-e827-45d51ae48ba9"},"execution_count":29,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]}]}