))]:\n","    print(f\"\\n── Intensity Summary: {label} (n = {n}) ──────────────────\")\n","    print(f\"CN intensity: mean = {subset['cn_intensity'].mean():.4f},  std = {subset['cn_intensity'].std():.4f}\")\n","    print(f\"EN intensity: mean = {subset['en_intensity'].mean():.4f},  std = {subset['en_intensity'].std():.4f}\")\n","    print(f\"Diff (CN−EN): mean = {subset['intensity_diff'].mean():.4f},  std = {subset['intensity_diff'].std():.4f}\")\n","\n","    w_stat, w_p = wilcoxon(subset[\"cn_intensity\"], subset[\"en_intensity\"])\n","    print(f\"Wilcoxon signed-rank: W = {w_stat:.1f},  p = {w_p:.4f}\")\n","    print(f\"Diluted   (CN > EN): {(subset['intensity_diff'] > 0).sum()} rows\")\n","    print(f\"Amplified (EN > CN): {(subset['intensity_diff'] < 0).sum()} rows\")\n","\n","# ── By Sentiment Label ─────────────────────────────────────────────────\n","for subset, label in [(agree,    \"Label-consistent (Agree)\"),\n","                       (disagree, \"Label-inconsistent (Disagree)\")]:\n","    print(f\"\\n── Intensity by Sentiment Label: {label} ──────────────\")\n","    tbl = subset.groupby(\"chinese_sentiment_label\").agg(\n","        CN_intensity_mean = (\"cn_intensity\",   \"mean\"),\n","        EN_intensity_mean = (\"en_intensity\",   \"mean\"),\n","        diff_mean         = (\"intensity_diff\", \"mean\"),\n","        diff_std          = (\"intensity_diff\", \"std\"),\n","        n                 = (\"intensity_diff\", \"count\"),\n","    ).reindex(SENTIMENTS).round(4).rename_axis(\"Sentiment Label\")\n","    print(tbl)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9iSzpE9bWfcr","executionInfo":{"status":"ok","timestamp":1792836657971,"user_tz":-480,"elapsed":5,"user":{"displayName":"na na","userId":"04015591375855126319"}},"outputId":"92ff9589-10dc-4207-af31-45d7f0be5a03"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["cn_polarity sample: count    273.0000\n","mean      -0.2030\n","std        0.